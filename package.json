{
  "name": "vibelog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live coding telemetry + OBS overlay for vibe coding streams (V0, 100% local)",
  "bin": {
    "vibe": "src/cli.ts"
  },
  "scripts": {
    "vibe": "tsx src/cli.ts",
    "test": "node --test --import tsx \"src/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "release:check": "release-kit check && npm run typecheck && npm test && npm --prefix worker ci && npm --prefix worker run typecheck && npm --prefix worker test",
    "release": "release-kit release",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "release-kit": "github:n8watkins/release-kit#v2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "overrides": {
    "zod": "^4.6.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
